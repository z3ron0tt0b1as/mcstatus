# ============================================================================
#  Is Minecraft Down? — environment variables
#  Copy to ".env" and fill in. Every integration is OPTIONAL: with nothing set
#  the site still runs and falls back to in-browser (localStorage) incident
#  tracking and synthesized community data.
# ============================================================================

# --- Supabase (incident timeline, community reports, email subscriptions) ----
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://wiphjnwvnoeqfovxtyru.supabase.co
# Service-role key (Project Settings -> API). Server-side only — never exposed
# to the browser. Bypasses RLS so the probe can write incidents.
# Put the REAL value in ".env" (which is gitignored), never in this template.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndpcGhqbnd2bm9lcWZvdnh0eXJ1Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MjczNDc1OSwiZXhwIjoyMDk4MzEwNzU5fQ.A8YtwymrNMjnRAYoAa5odYJyDwdL6a6WsDBFfAF1Fg8

# --- Email outage alerts (via Resend, https://resend.com) --------------------
# Without this, subscriptions are still stored but no mail is sent.
RESEND_API_KEY=re_UGxVpR7c_6jGTAhFVWXeYhoc1dVdZa1yz
# Verified sender address for outage emails.
ALERT_FROM_EMAIL=mcstatus@prismaticsky.xyz
# Public base URL used in email links (no trailing slash). Required for the
# confirmation/outage emails' "View live status" and unsubscribe links to work.
PUBLIC_SITE_URL=https://status.prismaticsky.xyz
# Secret used to sign one-click unsubscribe tokens. Set any long random string.
# Falls back to SUPABASE_SERVICE_ROLE_KEY, then a dev default, if unset.
UNSUBSCRIBE_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndpcGhqbnd2bm9lcWZvdnh0eXJ1Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MjczNDc1OSwiZXhwIjoyMDk4MzEwNzU5fQ.A8YtwymrNMjnRAYoAa5odYJyDwdL6a6WsDBFfAF1Fg8